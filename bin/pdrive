#!/usr/bin/env python3
"""pdrive - Proton Drive through Proton's official CLI, for the bar panel.

  pdrive status                  JSON: is the CLI installed, is anyone signed in
  pdrive login                   sign in through the browser (waits until done)
  pdrive logout                  sign out
  pdrive list PATH               JSON: a folder's items, folders first
  pdrive size [PATH]             JSON: bytes and items under PATH (default /my-files)
  pdrive upload PARENT FILE...   upload files or folders into PARENT, as JSON
  pdrive download PATH DIR       download PATH into the local DIR, as JSON
  pdrive share PATH              JSON: the public link to PATH, made if missing
  pdrive pick                    JSON: files chosen in the desktop file chooser

PATHs are Drive paths as the CLI takes them: /my-files is your root, so a file
is /my-files/Documents/cv.pdf. Uploads that meet a file of the same name keep
both (rename); folders are merged. Downloads never overwrite a local file.

The CLI (`proton-drive`) keeps its session in your keyring; nothing here
stores a password.
"""

import json
import os
import re
import shutil
import subprocess
import sys

CLI = "proton-drive"
ANSI_RE = re.compile(r"\x1b\[[0-9;?]*[A-Za-z]")


def emit(value):
    json.dump(value, sys.stdout)
    sys.stdout.write("\n")


def cli(*args, timeout=120):
    if not shutil.which(CLI):
        return 127, "", "proton-drive is not installed"
    try:
        proc = subprocess.run([CLI, *args], capture_output=True, text=True, timeout=timeout,
                              stdin=subprocess.DEVNULL)
    except subprocess.TimeoutExpired:
        return 124, "", "proton-drive timed out"
    return proc.returncode, proc.stdout, ANSI_RE.sub("", proc.stderr)


def last_line(text, fallback):
    lines = [l.strip() for l in ANSI_RE.sub("", text).splitlines() if l.strip()]
    # Skip stack-trace noise; the CLI prints the message itself first.
    lines = [l for l in lines if not l.startswith(("at ", "====", "Error details", "{", "}"))]
    return lines[0][:300] if lines else fallback


def parse_json(text):
    try:
        return json.loads(text)
    except ValueError:
        # Some commands log a line or two before the JSON.
        start = min([i for i in (text.find("["), text.find("{")) if i != -1] or [-1])
        if start == -1:
            return None
        try:
            return json.loads(text[start:])
        except ValueError:
            return None


def status():
    installed = bool(shutil.which(CLI))
    if not installed:
        return {"installed": False, "signedIn": False, "error": ""}
    # Listing "/" only prints the fixed top-level sections, so it is a cheap
    # way to ask whether a session exists.
    rc, out, err = cli("filesystem", "list", "/", "--json", timeout=30)
    signed_in = rc == 0
    error = "" if signed_in else last_line(err or out, "")
    if "login first" in error:
        error = ""
    return {"installed": True, "signedIn": signed_in, "error": error}


def name_of(node):
    name = node.get("name")
    if isinstance(name, dict):
        return name.get("value") if name.get("ok") else ""
    return name or ""


def listing(path):
    rc, out, err = cli("filesystem", "list", path, "--json", timeout=90)
    if rc != 0:
        return {"ok": False, "error": last_line(err or out, "could not list " + path), "items": []}
    items = []
    for node in parse_json(out) or []:
        name = name_of(node)
        if not name:
            continue
        rev = node.get("activeRevision") or {}
        items.append({
            "name": name,
            "path": path.rstrip("/") + "/" + name,
            "folder": node.get("type") == "folder",
            "size": rev.get("claimedSize") or node.get("totalStorageSize") or 0,
            "modified": rev.get("claimedModificationTime") or node.get("modificationTime") or "",
            "shared": bool(node.get("isShared")),
            "mediaType": node.get("mediaType") or "",
        })
    items.sort(key=lambda i: (not i["folder"], i["name"].lower()))
    return {"ok": True, "path": path, "items": items}


def size(path):
    rc, out, err = cli("filesystem", "size", path, "--json", timeout=300)
    data = parse_json(out) if rc == 0 else None
    if not isinstance(data, dict):
        return {"ok": False, "error": last_line(err or out, "could not size " + path)}
    return {"ok": True, "size": data.get("size", 0), "items": data.get("numberOfDescendants", 0)}


def transfer(kind, args):
    rc, out, err = cli("filesystem", kind, *args, "--json",
                       "--file-conflict-strategy", "rename", "--folder-conflict-strategy", "merge",
                       timeout=6 * 3600)
    summary = {}
    for line in out.splitlines():
        data = parse_json(line) if line.strip().startswith("{") else None
        if isinstance(data, dict) and "transferredItems" in data:
            summary = data
    out_json = {
        "ok": rc == 0,
        "items": summary.get("transferredItems", 0),
        "bytes": summary.get("transferredBytes", 0),
        "skipped": summary.get("skippedItems", 0),
        "failed": summary.get("failedItems", 0),
        "failures": [f.get("name", "") + ": " + f.get("error", "") for f in summary.get("failures", [])][:5],
    }
    if rc != 0 and not out_json["failures"]:
        out_json["error"] = last_line(err or out, kind + " failed")
    return out_json


def share(path):
    rc, out, err = cli("sharing", "set-url", path, "--json", timeout=90)
    data = parse_json(out) if rc == 0 else None
    url = ((data or {}).get("urlAccess") or {}).get("url", "") if isinstance(data, dict) else ""
    if not url:
        return {"ok": False, "error": last_line(err or out, "could not make a link")}
    return {"ok": True, "url": url}


def pick():
    picker = shutil.which("omarchy-file-select")
    if picker:
        cmd = [picker, "--title", "Upload to Proton Drive", "--multiple"]
    elif shutil.which("zenity"):
        cmd = ["zenity", "--file-selection", "--multiple", "--separator=\n", "--title=Upload to Proton Drive"]
    else:
        return []
    proc = subprocess.run(cmd, capture_output=True, text=True)
    return [p for p in proc.stdout.splitlines() if p.strip() and os.path.exists(p)]


def main(argv):
    cmd = argv[1] if len(argv) > 1 else "status"
    args = argv[2:]
    if cmd == "status":
        emit(status())
    elif cmd == "login":
        if not shutil.which(CLI):
            print("proton-drive is not installed", file=sys.stderr)
            return 127
        # Opens the browser itself and returns once the sign-in went through.
        return subprocess.call([CLI, "auth", "login"], stdin=subprocess.DEVNULL)
    elif cmd == "logout":
        rc, out, err = cli("auth", "logout")
        emit({"ok": rc == 0, "error": "" if rc == 0 else last_line(err or out, "logout failed")})
    elif cmd == "list" and len(args) == 1:
        emit(listing(args[0]))
    elif cmd == "size" and len(args) <= 1:
        emit(size(args[0] if args else "/my-files"))
    elif cmd == "upload" and len(args) >= 2:
        emit(transfer("upload", args[1:] + [args[0]]))
    elif cmd == "download" and len(args) == 2:
        os.makedirs(os.path.expanduser(args[1]), exist_ok=True)
        emit(transfer("download", [args[0], os.path.expanduser(args[1])]))
    elif cmd == "share" and len(args) == 1:
        emit(share(args[0]))
    elif cmd == "pick":
        emit(pick())
    else:
        print(__doc__.strip(), file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
